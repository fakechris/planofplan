# planofplan 环境变量（全部可选；密钥也可用 `planofplan auth set <slug> --key <v>` 存到 ~/.planofplan/credentials.json）

# 运行目录（默认 ~/.planofplan；config.json / credentials.json / planofplan.db 都在这里）
# PLANOFPPLAN_HOME=/path/to/data

# Web 端口（默认 9288）
# PLANOFPPLAN_PORT=9288

# ── MiniMax (adapter: minimax) ─────────────────────────────
# Coding Plan API Key，形如 sk-cp-*（不是开放平台 sk-api-*）
# MINIMAX_CODING_API_KEY=sk-cp-xxxx
# 普通 API Key 兜底（仅在 coding plan key 未设置时使用）
# MINIMAX_API_KEY=sk-api-xxxx
# 区域：cn（默认，https://www.minimaxi.com）| global（https://www.minimax.io）
# MINIMAX_REGION=cn
# host / URL 覆写（参考 CodexBar docs/minimax.md 的安全策略：仅 https、不含用户信息）
# MINIMAX_HOST=platform.minimaxi.com
# MINIMAX_REMAINS_URL=https://example.com/v1/api/openplatform/coding_plan/remains
