# planofplan 环境变量（全部可选；密钥也可用 `planofplan auth set <slug> --key <v>` 存到 ~/.planofplan/credentials.json）

# 运行目录（默认 ~/.planofplan；config.json / credentials.json / planofplan.db 都在这里）
# PLANOFPPLAN_HOME=/path/to/data

# Web 端口（默认 9288）
# PLANOFPPLAN_PORT=9288

# ── MiniMax (adapter: minimax) ─────────────────────────────
# Coding Plan API Key，形如 sk-cp-*（不是开放平台 sk-api-*）
# MINIMAX_CODING_API_KEY=sk-cp-xxxx
# 普通 API Key 兜底（仅在 coding plan key 未设置时使用）
# MINIMAX_API_KEY=sk-api-xxxx
# 区域：cn（默认，https://www.minimaxi.com）| global（https://www.minimax.io）
# MINIMAX_REGION=cn
# host / URL 覆写（参考 CodexBar docs/minimax.md 的安全策略：仅 https、不含用户信息）
# MINIMAX_HOST=platform.minimaxi.com
# MINIMAX_REMAINS_URL=https://example.com/v1/api/openplatform/coding_plan/remains

# ── GLM / z.ai（adapter: glm，覆盖 glm_legacy + glm_current）─────────
# global/cn: Z_AI_API_KEY（CodexBar）或 ZAI_API_KEY（onWatch）
# cn 还支持：BIGMODEL_API_KEY / ZHIPU_API_KEY / ZHIPUAI_API_KEY / GLM_API_KEY（或 relay 文件）
# Z_AI_API_KEY=
# ZAI_API_KEY=
# BIGMODEL_API_KEY=
# Z_AI_API_HOST=open.bigmodel.cn
# Z_AI_QUOTA_URL=https://open.bigmodel.cn/api/monitor/usage/quota/limit

# ── Codex（adapter: codex）───────────────────────────────
# 优先自动读 ~/.codex/auth.json（只读；过期请运行 `codex` 重新登录）
# CODEX_TOKEN=
# Token usage: local JSONL is automatic; opt-in to the Codex app-server's
# official account/usage/read daily buckets (may require Codex CLI support).
# CODEX_APP_SERVER_USAGE=1
# CODEX_CLI_PATH=/absolute/path/to/codex

# ── Local token log roots ─────────────────────────────────
# Defaults match the native CLIs. Override only if a provider uses a custom home.
# ZCODE_HOME=~/.zcode/cli
# KIMI_CODE_HOME=~/.kimi-code
# GROK_HOME=~/.grok
# DSH_HOME=~/.dsh
# FACTORY_HOME=~/.factory
# ZSTD_PATH=/opt/homebrew/bin/zstd  # DSH .jsonl.zstd reader

# ── Kimi（adapter: kimi）────────────────────────────────
# 优先自动读 ~/.kimi-code/credentials/kimi-code.json；过期时按 onWatch 规则自动刷新并写回
# 周(7天)+5h 额度来自 GET /coding/v1/usages；月限额（第三档）仅网页会话可取：
#   GetSubscriptionStats → subscriptionBalance.amountUsedRatio（共享订阅池，0-1 ×100）
# 月限额会话来源：登录 kimi.com 后自动读本机 kimi-auth cookie（kimi-desktop / Chromium 系明文 / Firefox）
#   或手动指定：KIMI_AUTH_TOKEN=<kimi-auth 值> / KIMI_AUTH_COOKIE_DB=<Cookies 文件路径>
# CLI access_token（15 分钟短 token）过期时默认用 refresh_token 静默换新并写回同一凭据文件。
# KIMI_USE_REFRESH=0  # 如需关闭自动刷新
# KIMI_CODE_OAUTH_HOST=https://auth.kimi.com
# 选择非 Default 浏览器 profile 时使用；浏览器读取只在用户主动执行 browser-auth 时触发
# KIMI_BROWSER_PROFILE=Default
# 选择非 Default 浏览器 profile 时使用（例如 Profile 1）；Keychain 读取只在用户主动触发 browser-auth 时发生
# KIMI_BROWSER_PROFILE=Default
# KIMI_CODE_API_KEY=
# KIMI_CODE_BASE_URL=https://api.kimi.com

# ── Grok（adapter: grok）────────────────────────────────
# 优先自动读 ~/.grok/auth.json（过期请运行 `grok login`）
# GROK_OAUTH_TOKEN=
# 注意：cli-chat-proxy.grok.com 在国内网络可能不可达，需代理（Bun fetch 暂不支持代理，建议系统级 TUN）

# ── Cursor（adapter: cursor）─────────────────────────────
# 优先自动读 Cursor 桌面端 state.vscdb（只读）；手动模式值 = 完整 Cookie 头：
# planofplan auth set cursor --key "WorkosCursorSessionToken=<userId>%3A%3A<token>"

# ── Claude（adapter: claude）─────────────────────────────
# 优先自动读 macOS Keychain "Claude Code-credentials"（OAuth；过期请运行 `claude` 重新登录）
# ANTHROPIC_TOKEN=
# ANTHROPIC_AUTH_TOKEN=
# Claude Code organization Analytics (Admin API key; separate from OAuth quota)
# ANTHROPIC_ADMIN_API_KEY=

# ── Factory Analytics (organization Manager/Owner API key) ─────────
# Historical token analytics; separate from Factory subscription quota windows.
# FACTORY_API_KEY=

# 需求 LLM 精炼层(也可在 config.json 的 llm.refine 开):1=开启
# PLANOFPLAN_REQUIREMENT_LLM=1
