# planofplan 环境变量（全部可选；密钥也可用 `planofplan auth set <slug> --key <v>` 存到 ~/.planofplan/credentials.json）

# 运行目录（默认 ~/.planofplan；config.json / credentials.json / planofplan.db 都在这里）
# PLANOFPPLAN_HOME=/path/to/data

# Web 端口（默认 9288）
# PLANOFPPLAN_PORT=9288

# ── MiniMax (adapter: minimax) ─────────────────────────────
# Coding Plan API Key，形如 sk-cp-*（不是开放平台 sk-api-*）
# MINIMAX_CODING_API_KEY=sk-cp-xxxx
# 普通 API Key 兜底（仅在 coding plan key 未设置时使用）
# MINIMAX_API_KEY=sk-api-xxxx
# 区域：cn（默认，https://www.minimaxi.com）| global（https://www.minimax.io）
# MINIMAX_REGION=cn
# host / URL 覆写（参考 CodexBar docs/minimax.md 的安全策略：仅 https、不含用户信息）
# MINIMAX_HOST=platform.minimaxi.com
# MINIMAX_REMAINS_URL=https://example.com/v1/api/openplatform/coding_plan/remains

# ── GLM / z.ai（adapter: glm，覆盖 glm_legacy + glm_current）─────────
# cn: BIGMODEL_API_KEY / ZHIPU_API_KEY / ZHIPUAI_API_KEY / GLM_API_KEY（或 relay 文件）
# global: Z_AI_API_KEY（BigModel 别名不用于 global）
# Z_AI_API_KEY=
# BIGMODEL_API_KEY=
# Z_AI_API_HOST=open.bigmodel.cn
# Z_AI_QUOTA_URL=https://open.bigmodel.cn/api/monitor/usage/quota/limit

# ── Codex（adapter: codex）───────────────────────────────
# 优先自动读 ~/.codex/auth.json（只读；过期请运行 `codex` 重新登录）
# CODEX_TOKEN=

# ── Kimi（adapter: kimi）────────────────────────────────
# 优先自动读 ~/.kimi-code/credentials/kimi-code.json（只读；过期请重新运行 kimi-code 登录）
# KIMI_CODE_API_KEY=
# KIMI_CODE_BASE_URL=https://api.kimi.com

# ── Grok（adapter: grok）────────────────────────────────
# 优先自动读 ~/.grok/auth.json（过期请运行 `grok login`）
# GROK_OAUTH_TOKEN=
# 注意：cli-chat-proxy.grok.com 在国内网络可能不可达，需代理（Bun fetch 暂不支持代理，建议系统级 TUN）

# ── Cursor（adapter: cursor）─────────────────────────────
# 优先自动读 Cursor 桌面端 state.vscdb（只读）；手动模式值 = 完整 Cookie 头：
# planofplan auth set cursor --key "WorkosCursorSessionToken=<userId>%3A%3A<token>"

# ── Claude（adapter: claude）─────────────────────────────
# 优先自动读 macOS Keychain "Claude Code-credentials"（OAuth；过期请运行 `claude` 重新登录）
# ANTHROPIC_TOKEN=
# ANTHROPIC_AUTH_TOKEN=
