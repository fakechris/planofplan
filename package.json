{
  "name": "planofplan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local insight hub for coding agents: multi-plan quota & token spend, cross-agent session index, session → requirement → commit lineage, read-only MCP",
  "scripts": {
    "serve": "bun src/cli.ts serve",
    "menubar:build": "./scripts/build-menubar.sh",
    "daemon:install": "./scripts/install-daemon.sh",
    "daemon:uninstall": "./scripts/uninstall-daemon.sh",
    "demo": "bun src/cli.ts serve --demo",
    "usage": "bun src/cli.ts usage",
    "status": "bun src/cli.ts status",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@steipete/sweet-cookie": "0.4.1",
    "hono": "^4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
